/target
node_modules/
# Environment files: secrets never belong in the repository. Templates
# (.env.example) stay tracked.
.env
.env.*
!.env.example
dist/
.dag/
.datu/
node.db*
secret.key
secret.mldsa65
.crush/
.DS_Store

# Local-only workspace: specs, session logs, demo credentials (private keys,
# bridge tokens, keystores). Never commit, never push - enforced by the
# global pre-commit hook and pre-push guard.
.dev-logs/
__pycache__/
*.pyc

# Generated by deploy/checks/inventory.py on every run (local and CI).
sbom-lite.json
sbom.spdx.json

# GESF runtime artifacts (the committed .ges config, score and governance
# records stay tracked; these churn on every run).
.ges/last-audit.json
.ges/activity-log.json
.ges/audit-cache.json
# Machine SBOM output from the SBOM gate.
sbom-filesystem.json
semgrep.sarif
