{
  "name": "@greenarmor/datu-client",
  "version": "0.1.0",
  "description": "Integrate a dApp with the DATU accountability DAG: SignetAuth login, signing, sealing, node reads and coverage verification",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greenarmor/datu-ledger.git",
    "directory": "sdk/datu-client"
  },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./mock": {
      "types": "./src/mock.d.ts",
      "default": "./src/mock.js"
    },
    "./auth": {
      "types": "./src/auth.d.ts",
      "default": "./src/auth.js"
    },
    "./errors": {
      "types": "./src/errors.d.ts",
      "default": "./src/errors.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "node --test test/*.test.mjs"
  },
  "keywords": [
    "datu",
    "signet",
    "signetauth",
    "webauthn",
    "accountability",
    "dag"
  ],
  "license": "MIT",
  "author": "DATU Contributors",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/greenarmor/datu-ledger/issues"
  },
  "homepage": "https://github.com/greenarmor/datu-ledger/tree/main/sdk/datu-client"
}
