# Per-user systemd unit for the projection indexer (same pattern as the node
# runbook: absolute paths, restart on failure, journald logs).
#   mkdir -p ~/.config/systemd/user
#   cp deploy/projection/datu-indexer.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now datu-indexer.service
#   journalctl --user -u datu-indexer -f
[Unit]
Description=DATU projection indexer
After=network-online.target
Wants=network-online.target

[Service]
# The database password lives in a 0600 env file
# (%h/.config/datu/indexer.env: DATU_DB_PASSWORD=...), never in this unit.
EnvironmentFile=%h/.config/datu/indexer.env
ExecStart=/usr/local/bin/datu-indexer \
  --data-dir %h/.datu \
  --db-url ${DATU_DB_URL} \
  --namespace gov.* \
  --verify signatures \
  --every 5
Restart=on-failure
RestartSec=5
# Hardening: no privilege escalation, a private /tmp, and the store is the
# only writable path under the home directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.datu

[Install]
WantedBy=default.target
