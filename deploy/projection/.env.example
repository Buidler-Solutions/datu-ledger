# Seed peer that grows into the reachable mesh (host:port).
DATU_SEED=anchor.example:7476
# Namespace allowlist for the projection (repeat patterns with a comma list
# is not supported; keep one broad pattern or edit the compose file).
DATU_NAMESPACES=gov.*
# Seconds between sync cycles / indexer passes.
NODE_EVERY=15
INDEX_EVERY=5
# The indexer's DSN. The password is separate (PG_PASSWORD below) and travels
# in the environment, never inside this URL.
DATU_DB_URL=postgres://datu@db:5432/datu
# PostgreSQL password and optional host ports.
PG_PASSWORD=change-me
PG_PORT=5432
EXPLORER_PORT=7474
